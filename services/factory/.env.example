# tasami-factory — environment contract
#
# Copy the keys, never this file's values. On Northflank these belong in the
# `factory-secrets` group linked to `factory-web` and `factory-worker`, not on
# the services themselves: a variable set on a service silently overrides the
# same key inherited from a group, and the only sign is a struck-through row.
#
# Blank is treated as unset (blanks are stripped before validation), so an
# empty box in the dashboard falls back to the default below rather than
# poisoning a URL. Required values have no default and stop the process.

# ─── Required ───────────────────────────────────────────────────────────────

# Paste the Northflank addon's string as-is. A plain `postgresql://` prefix is
# rewritten to `postgresql+asyncpg://` at boot — asyncpg is the only async
# driver here, so there is one correct rewrite and nothing is guessed.
DATABASE_URL=postgresql+asyncpg://user:password@host:5432/tasami

# Shared secret for the ingestion webhook. `openssl rand -hex 32`.
# Without it every delivery is rejected — the unattended door stays shut
# rather than defaulting open.
INGEST_WEBHOOK_SECRET=

# ─── Models: at least one, or no role can think ─────────────────────────────
#
# These are the keys that make the ten roles actually reason. With neither set
# every role records `produced: false`, intake cannot answer, and the ticket is
# HELD — the line runs and delivers nothing, visibly.
#
# Set them in the secret group only. They must never reach `sandbox-secrets`:
# the process holding the keys is not the process running model-written code.

# If both are set, OPENAI_API_KEY wins and Anthropic is never called. To use
# Anthropic, leave the OpenAI key genuinely absent — not blank-with-a-space.
OPENAI_API_KEY=
ANTHROPIC_API_KEY=

# ─── Execution sandbox ──────────────────────────────────────────────────────
#
# Both together or neither — one without the other is a half-configuration
# that would fail on the first run instead of at boot, so it reads as absent.
# The QA gate is decided by the sandbox's exit code, so with these unset the
# line reaches review and holds every ticket rather than passing unrun code.

# Internal DNS. No public domain: a reachable sandbox is an open RCE endpoint
# behind one shared secret.
SANDBOX_URL=http://sandbox:8080
SANDBOX_SECRET=
SANDBOX_TIMEOUT_SECONDS=120

# ─── Payments (optional; needed to invoice) ─────────────────────────────────
#
# The credentials and the webhook id must come from the SAME PayPal app.
# Verification calls PayPal with the credentials and the id together, so an id
# from another app rejects every delivery with 401 while the id is present, the
# credentials work, and health is green.

PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=
PAYPAL_ENVIRONMENT=sandbox
PAYPAL_WEBHOOK_ID=

# ─── Line behaviour ─────────────────────────────────────────────────────────

# Minor units. Above this a ticket reaches a person before the line starts —
# an automated line that accepts any price is one malformed payload away from
# committing to work it cannot deliver.
AUTO_ACCEPT_CEILING_MINOR=50000

MAX_PARALLEL_AGENTS=4
AGENT_TIMEOUT_SECONDS=120

# Where a released package is announced. Empty disables delivery entirely; it
# never falls back to sending anywhere.
DELIVERY_WEBHOOK_URL=
