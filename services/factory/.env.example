# Northflank maps these from the `factory-secrets` group. Every one is read at
# boot and validated; a missing required value stops the process rather than
# letting it serve a half-configured line.

# --- Core ---------------------------------------------------------------
DATABASE_URL=postgresql+asyncpg://user:pass@host:5432/factory
# openssl rand -hex 32
INGEST_WEBHOOK_SECRET=
# Comma-separated. Empty means the delivery webhook is disabled, not open.
DELIVERY_WEBHOOK_URL=

# --- Model provider (at least one) --------------------------------------
OPENAI_API_KEY=
ANTHROPIC_API_KEY=

# --- PayPal (receiving) -------------------------------------------------
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=
PAYPAL_ENVIRONMENT=sandbox
PAYPAL_WEBHOOK_ID=

# --- Limits -------------------------------------------------------------
# A ticket above this reaches a human before the line touches it.
AUTO_ACCEPT_CEILING_MINOR=50000
MAX_PARALLEL_AGENTS=4
AGENT_TIMEOUT_SECONDS=120
