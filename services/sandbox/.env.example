# tasami-sandbox — environment contract
#
# On Northflank these belong in a SEPARATE group, `sandbox-secrets`, linked to
# the `sandbox` service alone.
#
# What is deliberately absent matters more than what is here: no model API
# keys, no DATABASE_URL, no PayPal credentials. The sandbox needs none of them,
# and anything present in this environment is one `os.environ` read away from
# model-written code. The environment is scrubbed to a five-value allowlist
# before every run precisely so that assumption is never load-bearing.

# Must match SANDBOX_SECRET in `factory-secrets`. Requests are HMAC-signed over
# `timestamp.body` and compared in constant time.
SANDBOX_SECRET=

# The one value that is not a limit. There is no default: an unset policy
# leaves the service healthy and refusing to execute, which is loud without
# being a crash loop.
#
#   blocked-at-platform — a Northflank egress policy is applied (verified at
#                         boot against 443/80; a declaration that is not true
#                         makes the service refuse to run)
#   allowed             — deliberately open egress, chosen knowingly
#
SANDBOX_NETWORK_POLICY=blocked-at-platform

# ─── Ceilings on one run ────────────────────────────────────────────────────
#
# Wall clock and CPU are separate on purpose: a process that spins is killed by
# the kernel even when the supervisor is starved of scheduling.

SANDBOX_TIMEOUT_SECONDS=120
SANDBOX_CPU_SECONDS=90

# Reading a 25 MB CSV into pandas costs several times the file in RAM, string
# columns especially. At 512 MB an ordinary spreadsheet dies as an opaque
# MemoryError that reads like a bug in the generated script.
SANDBOX_MEMORY_MB=1024

# stdout/stderr from a run. A log, deliberately small.
SANDBOX_MAX_OUTPUT_BYTES=200000

# The uploaded and produced files. Stated separately from the log cap because a
# cleaned spreadsheet is the deliverable and is legitimately far larger.
SANDBOX_MAX_FILE_BYTES=25000000
SANDBOX_MAX_TOTAL_BYTES=100000000
SANDBOX_MAX_COLLECT_BYTES=50000000

SANDBOX_MAX_FILES=200

# Each concurrent run may take its full memory ceiling. 2 × 1024 MB is the
# floor for the service's own container, not a target.
SANDBOX_MAX_CONCURRENT=2
