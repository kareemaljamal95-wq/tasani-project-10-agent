# Northflank maps these from the `sandbox-secrets` group.

# Shared secret with the factory service. Without it every run is refused.
SANDBOX_SECRET=

# REQUIRED, no default. The service refuses to execute anything until you
# declare what stops a run from reaching the network:
#   blocked-at-platform  — a Northflank network policy denies egress from this
#                          service. The correct answer for production.
#   allowed              — egress is open. Only for code you wrote yourself.
# Left unset, /run returns 503. That is deliberate: a sandbox that silently
# runs with open egress is not a sandbox.
SANDBOX_NETWORK_POLICY=

# Hard ceilings applied to every run.
SANDBOX_TIMEOUT_SECONDS=60
SANDBOX_MEMORY_MB=512
SANDBOX_CPU_SECONDS=45
SANDBOX_MAX_OUTPUT_BYTES=200000
SANDBOX_MAX_FILE_BYTES=1000000
SANDBOX_MAX_FILES=200
SANDBOX_MAX_CONCURRENT=2
