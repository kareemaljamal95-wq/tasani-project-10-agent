generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id        String   @id @default(cuid())
  email     String   @unique
  name      String?
  password  String?
  image     String?
  language  String   @default("EN")
  theme     String   @default("DARK")
  timezone  String   @default("UTC")
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  agentConfigs   AgentConfig[]
  memories       Memory[]
  tasks          Task[]
  goals          Goal[]
  habits         Habit[]
  calendarEvents CalendarEvent[]
  conversations  Conversation[]
  approvals      Approval[]
  auditLogs      AuditLog[]
  agentRuns      AgentRun[]
  leads          Lead[]
  activities     Activity[]
  jobs           Job[]
  triggers       AutomationTrigger[]
  resetTokens    PasswordResetToken[]
  subscriptions  Subscription[]
  billingEvents  BillingEvent[]
  offerRedemptions OfferRedemption[]
  usageCounters  UsageCounter[]
  checkoutSessions CheckoutSession[]

  /// First-run onboarding. Null until the user finishes; set once so the flow
  /// never runs again. `onboardingStep` makes it resumable mid-way.
  onboardingCompletedAt DateTime?
  onboardingStep        String?
}

/// Lifecycle of anything an agent wants to do that touches the outside world.
///
///   PENDING  → APPROVED | EDITED | REJECTED
///   EDITED   → APPROVED | REJECTED
///   APPROVED → SENT | FAILED
///   FAILED   → APPROVED            (operator retry)
///   SENT, REJECTED                 (terminal)
enum ApprovalStatus {
  PENDING
  APPROVED
  REJECTED
  EDITED
  SENT
  FAILED
}

enum RiskLevel {
  low
  medium
  high
  critical
}

enum AuditType {
  agent_run
  approval_created
  approval_updated
  approval_edited
  approval_dispatched
  approval_dispatch_failed
  override_updated
  policy_blocked
  auth_failed
  auth_succeeded
  rate_limited
  discovery_scan
}

/// Human-approval gate. No outbound message may be sent without an APPROVED
/// row here; the transition to SENT is the only path to dispatch.
model Approval {
  id        String   @id @default(cuid())
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  agentId   String
  objective String
  amountUsd Decimal? @db.Decimal(12, 2)

  status ApprovalStatus @default(PENDING)

  /// Structured agent output, validated before it is written.
  decision Json

  /// Founder's rewrite. The original stays in `decision` so the difference
  /// between what the agent proposed and what a human sent stays auditable.
  editedAction String?

  channel       String?
  recipient     String?
  dispatchedAt  DateTime?
  failureReason String?

  decidedBy String?
  decidedAt DateTime?

  leadId String?
  lead   Lead?   @relation(fields: [leadId], references: [id], onDelete: SetNull)

  auditLogs AuditLog[]

  @@index([userId, status, createdAt])
  @@index([userId, agentId])
}

model AuditLog {
  id        String    @id @default(cuid())
  createdAt DateTime  @default(now())
  type      AuditType
  message   String
  /// Redacted payload — see `redact` in src/lib/logger.ts.
  data      Json?
  actor     String?

  userId String?
  user   User?   @relation(fields: [userId], references: [id], onDelete: SetNull)

  approvalId String?
  approval   Approval? @relation(fields: [approvalId], references: [id], onDelete: SetNull)

  @@index([createdAt])
  @@index([userId, createdAt])
  @@index([type, createdAt])
  @@index([approvalId])
}

model AgentRun {
  id        String     @id @default(cuid())
  createdAt DateTime   @default(now())
  userId    String
  user      User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  agentId   String
  objective String
  amountUsd Decimal?   @db.Decimal(12, 2)
  blocked   Boolean    @default(false)
  reason    String?
  riskLevel RiskLevel?
  requiresHumanApproval Boolean @default(true)
  latencyMs Int?
  modelUsed String?

  leadId String?
  lead   Lead?   @relation(fields: [leadId], references: [id], onDelete: SetNull)

  /// Set when the run came from automation rather than a person.
  jobId String?

  @@index([userId, createdAt])
  @@index([agentId, createdAt])
  @@index([leadId, createdAt])
}

/// Single-row-per-key settings. Holds the per-user `manualOverride` switch so
/// the sovereignty toggle survives restarts and deploys.
model SystemSetting {
  key       String   @id
  value     Json
  updatedAt DateTime @updatedAt
  updatedBy String?
}

model AgentConfig {
  id            String   @id @default(cuid())
  type          String
  name          String
  description   String?
  systemPrompt  String?
  model         String   @default("gpt-4o")
  temperature   Float    @default(0.7)
  isEnabled     Boolean  @default(true)
  userId        String
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, type])
  @@index([userId])
}

model Memory {
  id         String   @id @default(cuid())
  content    String
  type       String
  importance String   @default("MEDIUM")
  tags       String[]
  userId     String
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([userId, type])
}

model Task {
  id          String    @id @default(cuid())
  title       String
  description String?
  priority    String    @default("MEDIUM")
  status      String    @default("PENDING")
  dueDate     DateTime?
  userId      String
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model Goal {
  id        String   @id @default(cuid())
  title     String
  type      String
  status    String   @default("ACTIVE")
  progress  Int      @default(0)
  userId    String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model Habit {
  id               String   @id @default(cuid())
  name             String
  frequency        String   @default("DAILY")
  streak           Int      @default(0)
  bestStreak       Int      @default(0)
  totalCompletions Int      @default(0)
  isActive         Boolean  @default(true)
  daysOfWeek       Int[]
  timeOfDay        String   @default("09:00")
  userId           String
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model CalendarEvent {
  id          String    @id @default(cuid())
  title       String
  description String?
  startDate   DateTime
  endDate     DateTime?
  isAllDay    Boolean   @default(false)
  location    String?
  color       String?
  userId      String
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model Conversation {
  id         String   @id @default(cuid())
  title      String?
  userId     String
  agentType  String?
  isActive   Boolean  @default(true)
  isArchived Boolean  @default(false)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  user     User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  messages Message[]

  @@index([userId])
}

model Message {
  id             String   @id @default(cuid())
  content        String
  role           String
  conversationId String
  agentId        String?
  metadata       Json?
  model          String?
  createdAt      DateTime @default(now())

  conversation Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)

  @@index([conversationId])
}


// ---------------------------------------------------------------------------
// Leads
// ---------------------------------------------------------------------------

enum LeadStatus {
  NEW
  CONTACTED
  QUALIFIED
  PROPOSAL
  WON
  LOST
}

/// A prospect the workforce acts on.
///
/// Approval and AgentRun gain an optional leadId rather than growing parallel
/// per-lead copies of either concept, so an automated action against a lead
/// flows through exactly the same policy and approval pipeline as a manual one.
model Lead {
  id        String   @id @default(cuid())
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  companyName String
  contactName String?
  email       String?
  phone       String?
  website     String?
  source      String?
  notes       String?

  /// Where an imported lead came from, e.g. "google_places", and that
  /// source's own id for it.
  ///
  /// Discovery needs its own dedup key: a directory listing usually has a
  /// phone and a website but no email, and Postgres does not collide NULLs, so
  /// @@unique([userId, email]) lets the same business be imported on every
  /// re-scan. `source` stays the human-readable label.
  externalSource String?
  externalId     String?

  status LeadStatus @default(NEW)

  /// What the source published about the business, where it published it.
  ///
  /// Structured rather than folded into `notes` because these are scoring
  /// inputs: a rating held only inside a prose blob cannot be read back, so
  /// the score would be frozen at import instead of recomputable. Null means
  /// the source published nothing — never "zero stars".
  rating      Float?
  ratingCount Int?

  /// 0-100 opportunity score, derived from the signals above by
  /// `scoreLead` in src/lib/lead-scoring.ts. Recomputed whenever a scoring
  /// input changes; the A/B/C grade is derived from it and not stored.
  score Int @default(0)

  /// Agent type currently responsible, e.g. "SALES".
  assignedAgent String?

  lastContactedAt DateTime?

  approvals  Approval[]
  agentRuns  AgentRun[]
  activities Activity[]
  jobs       Job[]

  /// Deduplicates imports and automated creation within an account.
  @@unique([userId, email])
  /// Deduplicates repeated discovery scans, including for leads with no email.
  @@unique([userId, externalSource, externalId])
  @@index([userId, status, createdAt])
  @@index([userId, assignedAgent])
}

enum ActivityType {
  lead_created
  lead_updated
  status_changed
  agent_run
  approval_created
  approval_decided
  outreach_sent
  note
  automation
}

/// Append-only timeline for a lead. Distinct from AuditLog: AuditLog is the
/// security/compliance record, this is the user-facing history of the account's
/// work on a prospect.
model Activity {
  id        String       @id @default(cuid())
  createdAt DateTime     @default(now())
  type      ActivityType
  message   String
  data      Json?
  actor     String?

  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  leadId String?
  lead   Lead?   @relation(fields: [leadId], references: [id], onDelete: Cascade)

  @@index([userId, createdAt])
  @@index([leadId, createdAt])
}

// ---------------------------------------------------------------------------
// Automation
// ---------------------------------------------------------------------------

enum JobStatus {
  PENDING
  RUNNING
  SUCCEEDED
  FAILED
  CANCELLED
}

/// Minimal durable job queue.
///
/// Postgres-backed rather than a workflow platform: claimed with
/// FOR UPDATE SKIP LOCKED so several workers can run without double-executing,
/// retried with backoff, and deduplicated through idempotencyKey so a repeated
/// trigger cannot queue the same action twice.
model Job {
  id        String   @id @default(cuid())
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  leadId String?
  lead   Lead?   @relation(fields: [leadId], references: [id], onDelete: SetNull)

  kind    String
  payload Json

  status JobStatus @default(PENDING)

  runAt       DateTime @default(now())
  attempts    Int      @default(0)
  maxAttempts Int      @default(3)
  lastError   String?

  /// Held by a worker while running; a stale lock is reclaimed after a timeout.
  lockedAt DateTime?
  lockedBy String?

  /// Unique per account. The guard against duplicate automated actions.
  idempotencyKey String?

  triggerId String?
  trigger   AutomationTrigger? @relation(fields: [triggerId], references: [id], onDelete: SetNull)

  @@unique([userId, idempotencyKey])
  @@index([status, runAt])
  @@index([userId, createdAt])
}

/// A rule that enqueues jobs. Evaluated by the same worker that drains the
/// queue, so automation needs no second runtime.
model AutomationTrigger {
  id        String   @id @default(cuid())
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  name    String
  enabled Boolean @default(false)

  /// What starts it, e.g. "lead_status" or "schedule".
  kind String

  /// Only leads in this status are picked up, when kind is lead_status.
  leadStatus LeadStatus?

  /// Agent to run and the objective template applied to each match.
  agentType         String
  objectiveTemplate String

  /// Minimum gap between runs for the same lead, in hours.
  cooldownHours Int @default(24)

  lastRunAt DateTime?

  jobs Job[]

  @@index([userId, enabled])
}

// ---------------------------------------------------------------------------
// Auth support
// ---------------------------------------------------------------------------

/// Password reset. Only the hash is stored — the raw token exists solely in
/// the email that was sent, and is never written to the database or the logs.
model PasswordResetToken {
  id        String   @id @default(cuid())
  createdAt DateTime @default(now())

  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  tokenHash String    @unique
  expiresAt DateTime
  usedAt    DateTime?

  @@index([userId])
  @@index([expiresAt])
}

/// Cross-process rate limiting.
///
/// The in-process counter this replaces for sensitive endpoints enforced its
/// budget per replica, so N instances allowed N times the intended rate. This
/// is a fixed window shared through the database; Redis is the upgrade path
/// once request volume makes a database write per request too expensive.
model RateLimitCounter {
  key     String   @id
  count   Int      @default(0)
  resetAt DateTime

  @@index([resetAt])
}


// ---------------------------------------------------------------------------
// Billing
//
// `User` is the account. There is deliberately no second Account model: adding
// one would fork every existing ownership check, all of which already scope by
// userId.
//
// All money is stored as integer minor units (cents). Floating point currency
// is a rounding bug waiting for a customer to find it.
// ---------------------------------------------------------------------------

enum BillingInterval {
  MONTH
  YEAR
}

/// Subscription lifecycle. Nothing outside ACTIVE and TRIALING grants paid
/// entitlements except CANCELLED, which keeps access to the end of a period
/// already paid for.
enum SubscriptionStatus {
  TRIALING
  ACTIVE
  PAST_DUE
  CANCELLED
  EXPIRED
  SUSPENDED
}

enum CheckoutStatus {
  CREATED
  APPROVED
  COMPLETED
  FAILED
  EXPIRED
}

/// A commercial plan. Rows are projected from the code catalog in
/// src/lib/billing/catalog.ts, which stays the source of truth so a deploy can
/// change limits without a data migration.
model Plan {
  id          String   @id @default(cuid())
  code        String   @unique
  name        String
  description String
  active      Boolean  @default(true)
  sortOrder   Int      @default(0)

  /// Entitlement limits, resolved through src/lib/billing/entitlements.ts.
  /// Kept as JSON so adding a limit does not require a migration.
  limits Json

  metadata Json?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  prices        Price[]
  subscriptions Subscription[]

  @@index([active, sortOrder])
}

/// A billable variant of a plan. Monthly and annual are separate prices under
/// one plan rather than duplicated plans, so entitlement logic never branches
/// on interval.
model Price {
  id       String          @id @default(cuid())
  planId   String
  plan     Plan            @relation(fields: [planId], references: [id], onDelete: Cascade)
  interval BillingInterval
  currency String          @default("USD")
  /// Minor units. 4900 = $49.00.
  amount   Int
  active   Boolean         @default(true)

  provider        String?
  /// Provider-side plan/price identifier, populated once the provider has it.
  providerPriceId String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  subscriptions    Subscription[]
  checkoutSessions CheckoutSession[]

  @@unique([planId, interval, currency])
  @@index([active])
}

model Subscription {
  id     String @id @default(cuid())
  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  planId  String
  plan    Plan   @relation(fields: [planId], references: [id])
  priceId String?
  price   Price? @relation(fields: [priceId], references: [id])

  provider               String
  providerCustomerId     String?
  /// Unique per provider: the guard against a duplicate activation creating a
  /// second subscription row for one provider subscription.
  providerSubscriptionId String?

  status   SubscriptionStatus @default(TRIALING)
  currency String             @default("USD")
  amount   Int
  interval BillingInterval

  currentPeriodStart DateTime?
  currentPeriodEnd   DateTime?
  trialEndsAt        DateTime?

  cancelAtPeriodEnd Boolean   @default(false)
  cancelledAt       DateTime?

  metadata Json?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  offerRedemptions OfferRedemption[]
  billingEvents    BillingEvent[]

  @@unique([provider, providerSubscriptionId])
  @@index([userId, status])
  @@index([status, currentPeriodEnd])
}

/// Provider event log. `providerEventId` is unique, which is what makes
/// webhook processing idempotent under duplicate and retried delivery.
///
/// No card data, no tokens, no raw payload: only a hash for correlation and a
/// redacted metadata object.
model BillingEvent {
  id              String @id @default(cuid())
  provider        String
  providerEventId String
  eventType       String

  userId String?
  user   User?   @relation(fields: [userId], references: [id], onDelete: SetNull)

  subscriptionId String?
  subscription   Subscription? @relation(fields: [subscriptionId], references: [id], onDelete: SetNull)

  status      String    @default("processed")
  processedAt DateTime?
  /// SHA-256 of the raw body, for correlating a report with a delivery.
  payloadHash String?
  metadata    Json?
  error       String?

  createdAt DateTime @default(now())

  @@unique([provider, providerEventId])
  @@index([eventType, createdAt])
  @@index([userId, createdAt])
}

/// A promotional price, e.g. the founding-partner offer. Modelled as data so
/// no customer-specific branch ever enters the application.
model Offer {
  code        String   @id
  name        String
  description String
  active      Boolean  @default(true)

  startsAt DateTime?
  endsAt   DateTime?

  /// How many billing periods the discounted amount applies for.
  durationMonths Int    @default(3)
  currency       String @default("USD")
  /// Minor units, the discounted price itself rather than a percentage.
  amount         Int

  maxRedemptions Int
  /// Incremented only by a conditional UPDATE guarded on maxRedemptions, so
  /// the cap holds under concurrency.
  redemptionCount Int @default(0)

  /// Plan codes the offer may be applied to; empty means any plan.
  eligiblePlanCodes String[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  redemptions OfferRedemption[]
}

model OfferRedemption {
  id        String @id @default(cuid())
  offerCode String
  offer     Offer  @relation(fields: [offerCode], references: [code], onDelete: Cascade)

  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  subscriptionId String?
  subscription   Subscription? @relation(fields: [subscriptionId], references: [id], onDelete: SetNull)

  redeemedAt DateTime  @default(now())
  expiresAt  DateTime?

  /// One redemption of a given offer per account.
  @@unique([offerCode, userId])
  @@index([userId])
}

/// Server-created checkout intent. The client never supplies plan, price,
/// amount or currency for the actual charge — those are resolved here from
/// trusted configuration and stored before the provider is contacted.
model CheckoutSession {
  id     String @id @default(cuid())
  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  priceId String
  price   Price  @relation(fields: [priceId], references: [id])

  planCode  String
  offerCode String?

  provider           String
  providerOrderId    String?
  providerApprovalUrl String?

  currency String
  amount   Int

  status CheckoutStatus @default(CREATED)

  /// Deduplicates double-clicks, browser retries and network retries.
  idempotencyKey String

  expiresAt DateTime?
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt

  @@unique([userId, idempotencyKey])
  @@index([userId, status])
  @@index([provider, providerOrderId])
}

/// Metered usage, counted per account per billing period.
///
/// An "AI action" is one billable unit of agent work: exactly one successful
/// call to executeAgent that reached the model. Policy-blocked runs are not
/// counted — the customer is not charged for the system refusing.
model UsageCounter {
  id     String @id @default(cuid())
  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  /// Billing period this counter belongs to, as YYYY-MM-DD of the period start.
  periodKey   String
  periodStart DateTime
  periodEnd   DateTime

  metric String @default("ai_actions")
  /// Incremented by a single atomic statement so concurrent requests cannot
  /// both read the same value and overshoot the limit.
  count  Int    @default(0)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([userId, periodKey, metric])
  @@index([userId, periodKey])
}
