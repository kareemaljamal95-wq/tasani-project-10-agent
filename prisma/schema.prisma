generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id        String   @id @default(cuid())
  email     String   @unique
  name      String?
  password  String?
  image     String?
  language  String   @default("EN")
  theme     String   @default("DARK")
  timezone  String   @default("UTC")
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  agentConfigs   AgentConfig[]
  memories       Memory[]
  tasks          Task[]
  goals          Goal[]
  habits         Habit[]
  calendarEvents CalendarEvent[]
  conversations  Conversation[]
  approvals      Approval[]
  auditLogs      AuditLog[]
  agentRuns      AgentRun[]
}

/// Lifecycle of anything an agent wants to do that touches the outside world.
///
///   PENDING  → APPROVED | EDITED | REJECTED
///   EDITED   → APPROVED | REJECTED
///   APPROVED → SENT | FAILED
///   FAILED   → APPROVED            (operator retry)
///   SENT, REJECTED                 (terminal)
enum ApprovalStatus {
  PENDING
  APPROVED
  REJECTED
  EDITED
  SENT
  FAILED
}

enum RiskLevel {
  low
  medium
  high
  critical
}

enum AuditType {
  agent_run
  approval_created
  approval_updated
  approval_edited
  approval_dispatched
  approval_dispatch_failed
  override_updated
  policy_blocked
  auth_failed
  auth_succeeded
  rate_limited
}

/// Human-approval gate. No outbound message may be sent without an APPROVED
/// row here; the transition to SENT is the only path to dispatch.
model Approval {
  id        String   @id @default(cuid())
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  agentId   String
  objective String
  amountUsd Decimal? @db.Decimal(12, 2)

  status ApprovalStatus @default(PENDING)

  /// Structured agent output, validated before it is written.
  decision Json

  /// Founder's rewrite. The original stays in `decision` so the difference
  /// between what the agent proposed and what a human sent stays auditable.
  editedAction String?

  channel       String?
  recipient     String?
  dispatchedAt  DateTime?
  failureReason String?

  decidedBy String?
  decidedAt DateTime?

  auditLogs AuditLog[]

  @@index([userId, status, createdAt])
  @@index([userId, agentId])
}

model AuditLog {
  id        String    @id @default(cuid())
  createdAt DateTime  @default(now())
  type      AuditType
  message   String
  /// Redacted payload — see `redact` in src/lib/logger.ts.
  data      Json?
  actor     String?

  userId String?
  user   User?   @relation(fields: [userId], references: [id], onDelete: SetNull)

  approvalId String?
  approval   Approval? @relation(fields: [approvalId], references: [id], onDelete: SetNull)

  @@index([createdAt])
  @@index([userId, createdAt])
  @@index([type, createdAt])
  @@index([approvalId])
}

model AgentRun {
  id        String     @id @default(cuid())
  createdAt DateTime   @default(now())
  userId    String
  user      User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  agentId   String
  objective String
  amountUsd Decimal?   @db.Decimal(12, 2)
  blocked   Boolean    @default(false)
  reason    String?
  riskLevel RiskLevel?
  requiresHumanApproval Boolean @default(true)
  latencyMs Int?
  modelUsed String?

  @@index([userId, createdAt])
  @@index([agentId, createdAt])
}

/// Single-row-per-key settings. Holds the per-user `manualOverride` switch so
/// the sovereignty toggle survives restarts and deploys.
model SystemSetting {
  key       String   @id
  value     Json
  updatedAt DateTime @updatedAt
  updatedBy String?
}

model AgentConfig {
  id            String   @id @default(cuid())
  type          String
  name          String
  description   String?
  systemPrompt  String?
  model         String   @default("gpt-4o")
  temperature   Float    @default(0.7)
  isEnabled     Boolean  @default(true)
  userId        String
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, type])
  @@index([userId])
}

model Memory {
  id         String   @id @default(cuid())
  content    String
  type       String
  importance String   @default("MEDIUM")
  tags       String[]
  userId     String
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([userId, type])
}

model Task {
  id          String    @id @default(cuid())
  title       String
  description String?
  priority    String    @default("MEDIUM")
  status      String    @default("PENDING")
  dueDate     DateTime?
  userId      String
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model Goal {
  id        String   @id @default(cuid())
  title     String
  type      String
  status    String   @default("ACTIVE")
  progress  Int      @default(0)
  userId    String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model Habit {
  id               String   @id @default(cuid())
  name             String
  frequency        String   @default("DAILY")
  streak           Int      @default(0)
  bestStreak       Int      @default(0)
  totalCompletions Int      @default(0)
  isActive         Boolean  @default(true)
  daysOfWeek       Int[]
  timeOfDay        String   @default("09:00")
  userId           String
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model CalendarEvent {
  id          String    @id @default(cuid())
  title       String
  description String?
  startDate   DateTime
  endDate     DateTime?
  isAllDay    Boolean   @default(false)
  location    String?
  color       String?
  userId      String
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model Conversation {
  id         String   @id @default(cuid())
  title      String?
  userId     String
  agentType  String?
  isActive   Boolean  @default(true)
  isArchived Boolean  @default(false)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  user     User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  messages Message[]

  @@index([userId])
}

model Message {
  id             String   @id @default(cuid())
  content        String
  role           String
  conversationId String
  agentId        String?
  metadata       Json?
  model          String?
  createdAt      DateTime @default(now())

  conversation Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)

  @@index([conversationId])
}
