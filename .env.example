# ---------------------------------------------------------------------------
# Tasami OS — environment configuration
#
# Copy to .env and fill in. The app validates this on boot and refuses to start
# with an invalid configuration rather than degrading into an insecure mode.
# Never commit a filled-in .env; .gitignore already excludes it.
# ---------------------------------------------------------------------------

# --- Required ---------------------------------------------------------------

# PostgreSQL connection string.
DATABASE_URL="postgresql://user:password@localhost:5432/tasami"

# Direct (non-pooled) connection, used for migrations only. Set this when
# DATABASE_URL points at a transaction pooler (pgBouncer, Supabase :6543, a
# *-pooler host) — migrations cannot run over one. Leave empty otherwise.
DIRECT_DATABASE_URL=""

# Signs session cookies. Minimum 32 characters.
# Generate with: openssl rand -hex 32
# Rotating this value invalidates every active session (emergency logout).
AUTH_SECRET=""

# --- AI providers -----------------------------------------------------------
# At least one is required for agents to run. Routes return 503 when none is
# set rather than pretending to answer.

OPENAI_API_KEY=""
ANTHROPIC_API_KEY=""
GEMINI_API_KEY=""

# --- Outbound delivery ------------------------------------------------------
# "none" (default) means an approved message cannot be dispatched: the attempt
# fails and the approval is marked FAILED rather than falsely marked SENT.
# Set to "smtp" and provide SMTP_URL to enable real sending.

OUTREACH_TRANSPORT="none"
SMTP_URL=""
OUTREACH_FROM=""

# --- Optional ---------------------------------------------------------------

NODE_ENV="development"
PORT="3000"

# Public origin. Canonical URLs, sitemap, OpenGraph, PayPal return URLs and
# password-reset links all resolve against this. No trailing slash.
# Leaving it blank in a hosting dashboard is now equivalent to leaving it unset
# (the fallback applies), but the fallback is localhost — so a deploy that
# builds green with this blank will publish localhost URLs. Set it.
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# Session lifetime in hours (default 168 = 7 days).
SESSION_TTL_HOURS="168"

# Rate limiting, per client per window.
RATE_LIMIT_MAX="60"
RATE_LIMIT_WINDOW_MS="60000"
# Tighter budget for /api/auth, the credential-stuffing surface.
AUTH_RATE_LIMIT_MAX="10"

# --- Automation --------------------------------------------------------------
# Credential for the unattended automation worker (POST /api/automation/run
# with an x-worker-key header). Minimum 32 characters.
# Generate with: openssl rand -hex 32
# Without it the scheduled path is CLOSED — only a signed-in session can drive
# automation. There is no default and no bypass.
WORKER_API_KEY=""

# Vercel Cron presents this as a bearer token on the scheduled GET to
# /api/automation/run. Vercel generates and injects it automatically; set it
# yourself on any other platform whose scheduler can only issue a GET.
# Without it, that path is CLOSED — same posture as WORKER_API_KEY.
CRON_SECRET=""

# --- Business discovery -------------------------------------------------------
# Google Places API key. Discovery searches a real directory for businesses in
# a market and imports them as leads.
# Without it discovery fails closed with 503 — it never falls back to fixtures.
GOOGLE_PLACES_API_KEY=""

# Poll interval for the standalone worker process (npm run worker).
WORKER_INTERVAL_MS="30000"

# --- Billing (PayPal) --------------------------------------------------------
# PAYPAL_CLIENT_SECRET is server-only and must NEVER reach the browser.
# The client id may be public where PayPal's client integration requires it.
PAYPAL_CLIENT_ID=""
PAYPAL_CLIENT_SECRET=""
PAYPAL_ENVIRONMENT="sandbox"      # sandbox | production

# Webhook id from the PayPal developer dashboard, for the webhook you created
# pointing at:  https://your-host/api/billing/webhooks/paypal
# Without it EVERY webhook is rejected — the handler fails closed rather than
# trusting an unverified payload.
PAYPAL_WEBHOOK_ID=""
