# ---------------------------------------------------------------------------
# Tasami OS — environment configuration
#
# Copy to .env and fill in. The app validates this on boot and refuses to start
# with an invalid configuration rather than degrading into an insecure mode.
# Never commit a filled-in .env; .gitignore already excludes it.
# ---------------------------------------------------------------------------

# --- Required ---------------------------------------------------------------

# PostgreSQL connection string.
DATABASE_URL="postgresql://user:password@localhost:5432/tasami"

# Signs session cookies. Minimum 32 characters.
# Generate with: openssl rand -hex 32
# Rotating this value invalidates every active session (emergency logout).
AUTH_SECRET=""

# --- AI providers -----------------------------------------------------------
# At least one is required for agents to run. Routes return 503 when none is
# set rather than pretending to answer.

OPENAI_API_KEY=""
ANTHROPIC_API_KEY=""
GEMINI_API_KEY=""

# --- Outbound delivery ------------------------------------------------------
# "none" (default) means an approved message cannot be dispatched: the attempt
# fails and the approval is marked FAILED rather than falsely marked SENT.
# Set to "smtp" and provide SMTP_URL to enable real sending.

OUTREACH_TRANSPORT="none"
SMTP_URL=""
OUTREACH_FROM=""

# --- Optional ---------------------------------------------------------------

NODE_ENV="development"
PORT="3000"

# Public origin. Canonical URLs, sitemap and OpenGraph resolve against this.
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# Session lifetime in hours (default 168 = 7 days).
SESSION_TTL_HOURS="168"

# Rate limiting, per client per window.
RATE_LIMIT_MAX="60"
RATE_LIMIT_WINDOW_MS="60000"
# Tighter budget for /api/auth, the credential-stuffing surface.
AUTH_RATE_LIMIT_MAX="10"
